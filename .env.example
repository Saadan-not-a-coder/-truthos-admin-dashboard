# Supabase (client-safe — set in Vercel for each environment)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shown on sign-up page hint only — actual validation runs in Edge Function
# Set ADMIN_SIGNUP_CODE as a Supabase Edge Function secret (not in the client bundle)
VITE_ADMIN_SIGNUP_CODE=your-admin-signup-code

# Supabase Edge Function secrets (Supabase dashboard → Edge Functions → Secrets)
# SUPABASE_URL= (auto)
# SUPABASE_ANON_KEY= (auto)
# SUPABASE_SERVICE_ROLE_KEY= (auto)
# ADMIN_SIGNUP_CODE=your-admin-signup-code
